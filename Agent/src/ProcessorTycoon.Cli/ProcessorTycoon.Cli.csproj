<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>pt-agent</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- All generated text and JSON use invariant formatting ("1653.43", not the OS locale's "1653,43"). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.5.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\AGENT_GUIDE.md" LogicalName="AgentGuide" />
    <InternalsVisibleTo Include="ProcessorTycoon.Tests" />
  </ItemGroup>
</Project>
